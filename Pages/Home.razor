@page "/home"

@using System.Diagnostics;
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Web;

<h3>Home</h3>

<div>
    <h2>Drag and Drop Example</h2>
    <div
        @ondragstart="OnDragStart"
        @ondragend="OnDragEnd"
        @ondragover="OnDragOver"
        @ondrop="OnDrop"
        style="border: solid 1px black; height: 200px; width: 200px;">
        Drag Here
    </div>
</div>

@code {
    ElementReference nameElementRef;

    private void SetNameElementRef(ElementReference reference)
    {
        nameElementRef = reference;
    }

    private void OnDragStart(DragEventArgs e)
    {
        Console.WriteLine("[DragStart] Dragging started");
    }

    private void OnDragEnd(DragEventArgs e)
    {
        Console.WriteLine("[DragEnd] Dragging ended");
    }

    private void OnDragOver(DragEventArgs e)
    {
        e.PreventDefault();
        Console.WriteLine("[DragOver] Dragging over the drop zone");
    }

    private void OnDrop(DragEventArgs e)
    {
        Console.WriteLine("[Drop] Item dropped");
    }
}